# ============================================
# Archivos generados automáticamente (NO versionar)
# ============================================

# Caché y bytecode de Python (se regeneran automáticamente)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Entornos virtuales (muy grandes, se recrean con requirements.txt)
venv/
env/
ENV/
.venv/

# Checkpoints temporales de Jupyter
.ipynb_checkpoints/

# ============================================
# Archivos del sistema operativo (NO versionar)
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ============================================
# Archivos de IDE (opcional - descomenta si no quieres versionarlos)
# ============================================

# .vscode/
# .idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ============================================
# Logs temporales (NO versionar)
# ============================================

*.log
*.log.*

# ============================================
# NOTA: Los siguientes archivos SÍ se versionan:
# - *.pkl (modelos entrenados - parte del trabajo)
# - execution_results.json (resultados documentados)
# - execution_results/ (si son relevantes para el TFM)
# - Todos los notebooks, scripts, documentación, etc.
# ============================================