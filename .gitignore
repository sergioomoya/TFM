# ============================================
# Archivos generados automáticamente (NO versionar)
# ============================================

# Caché y bytecode de Python (se regeneran automáticamente)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Entornos virtuales (muy grandes, se recrean con requirements.txt)
venv/
env/
ENV/
.venv/

# Checkpoints temporales de Jupyter
.ipynb_checkpoints/

# Sincronización local (GitHub + Google Drive); solo en esta máquina
sync-to-google-drive.ps1

# ============================================
# Archivos del sistema operativo (NO versionar)
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Temporales de Microsoft Office (Word, Excel, etc.)
~$*
~WRL*.tmp
~*.tmp
*.tmp

# Linux
*~

# ============================================
# Archivos de IDE (opcional - descomenta si no quieres versionarlos)
# ============================================

# .vscode/
# .idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ============================================
# Logs temporales (NO versionar)
# ============================================

*.log
*.log.*

# ============================================
# Archivos multimedia y datos pesados (NO versionar)
# ============================================
*.mp3
*.mp4
*.avi
*.mov
*.csv
*.pkl
*.zip
*.tar.gz
*.rar

# Datos simulados generados por los cuadernos
simulated-data-raw/
simulated-data-transformed/

# Resultados de experimentos (se regeneran al ejecutar)
execution_results/
execution_results.json
experiments/results/*.pkl
experiments/results/*.csv
experiments/results/*.json
experiments/results/*.ipynb
experiments/results/figures/
performances_*.pkl