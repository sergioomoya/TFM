# =============================================================================
# Dockerfile.gpu - TFM Detección de Fraude (RTX 50 series / Blackwell)
# =============================================================================
# Imagen con PyTorch + CUDA 12.8 para RTX 5080/5090 (compute capability sm_120).
# Requiere CUDA 12.8 y PyTorch 2.7+ para soporte oficial.
#
# Requiere:
#   - Docker Desktop con WSL2 backend
#   - NVIDIA Container Toolkit
#   - GPU NVIDIA RTX 5080/5090 (Blackwell)
#
# Uso:
#   docker compose build ch7-gpu
#   docker compose run --rm ch7-gpu
# =============================================================================

FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

LABEL maintainer="TFM Detección de Fraude - Sergio Moya"
LABEL description="Entorno Docker con GPU RTX 5080 para Deep Learning (Chapter 7)"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Ubuntu 22.04: Python 3.10
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3.10-dev \
    python3-pip \
    build-essential \
    curl \
    git \
    graphviz \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/bin/python \
    && ln -sf /usr/bin/pip3 /usr/bin/pip

WORKDIR /app

# PyTorch 2.7+ con CUDA 12.8 (soporte RTX 5080/5090)
RUN pip install --upgrade pip && \
    pip install torch torchvision --index-url https://download.pytorch.org/whl/cu128

# Resto de dependencias (compatibles con Python 3.10 y numpy 2.x de PyTorch)
# pandas>=2.0 obligatorio: numpy 2.x (traído por PyTorch) es incompatible con pandas<2
COPY requirements.txt .
RUN pip install "pandas>=2.0" scikit-learn matplotlib seaborn graphviz xgboost imbalanced-learn shap skorch \
    pandarallel jupyter jupyter-book Sphinx sphinxcontrib-bibtex \
    nbconvert papermill jupyter-client ipykernel lxml_html_clean && \
    pip install --force-reinstall --no-deps "pandas>=2.0" && \
    python -m ipykernel install --user --name python3

COPY . .

CMD ["python", "run_unified_notebooks.py", "--notebook", "Chapter_7_DeepLearning/Chapter_7_Unified.ipynb"]
