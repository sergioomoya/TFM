# =============================================================================
# .gitignore - TFM Detección de Fraude
# =============================================================================

# ---------------------
# Datos generados por la ejecución de los cuadernos del baseline
# ---------------------
simulated-data-raw/
simulated-data-transformed/

# ---------------------
# Resultados de experimentos (archivos pesados generados automáticamente)
# ---------------------
experiments/results/*.pkl
experiments/results/*.csv
experiments/results/*.json
experiments/results/figures/

# ---------------------
# Python
# ---------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# ---------------------
# Jupyter Notebook
# ---------------------
.ipynb_checkpoints/
*.ipynb_checkpoints/
.jupyter_cache/

# ---------------------
# Entorno virtual
# ---------------------
.venv/
venv/
env/
ENV/

# ---------------------
# IDE / Editor
# ---------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------
# Sistema operativo
# ---------------------
Thumbs.db
Desktop.ini
.DS_Store

# ---------------------
# Docker
# ---------------------
notebook-cache/

# ---------------------
# Archivos temporales de ejecución
# ---------------------
execution_results/
execution_results.json
